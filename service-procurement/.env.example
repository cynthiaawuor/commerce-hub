# Copy this file to `.env` for local development.

PORT=3001

# Procurement's own database (the procurement-db service in compose.yml).
# No other service may connect to it. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/service-procurement"

# Vendor Management, used to look up suppliers and lock catalog prices onto an order
VENDOR_API_URL="http://localhost:3000/vendor-api"
VENDOR_TIMEOUT_MS=5000

# Event bus. Domain events are written to the outbox table, then published here.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
OUTBOX_POLL_MS=2000

# Phase flag for this module (phase 1). Set to "false" to hide its routes and stop
# consuming events, without removing the service.
FEATURE_PROCUREMENT=true

# Retry limits. An outbox event that fails for its own reasons OUTBOX_MAX_ATTEMPTS times is
# marked DEAD; a consumed message that fails CONSUMER_MAX_RETRIES times goes to <queue>.dead.
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=2000
OUTBOX_RETRY_MAX_MS=300000
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=10000
