model Supplier {
    id           String            @id @default(uuid())
    name         String
    email        String            @unique
    phone        String
    paymentTerms String
    status       String            @default("ACTIVE")
    createdAt    TimestamptzString @default(now())
    updatedAt    temporal.updatedAtString()

    deliveries Delivery[]
    catalog    CatalogItem[]
}

model CatalogItem {
    id           String            @id @default(uuid())
    name         String
    description  String
    unitPrice    Float
    leadTimeDays Int
    createdAt    TimestamptzString @default(now())
    updatedAt    temporal.updatedAtString()

    supplierId String @unique
    productId  String @unique //relates to inventory service

    supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
    deliveryMetrics DeliveryMetric[]
}

// ------------------------------------------------------
// Logs every time a truck arrives
// ------------------------------------------------------
model Delivery {
    id         String @id @default(uuid())
    supplierId String

    // Soft Relations to other modules
    purchaseOrderId String

    // Time Performance
    expectedDate TimestamptzString
    actualDate   TimestamptzString
    daysLate     Int               @default(0) // 0 if early/on-time

    createdAt TimestamptzString @default(now())

    // Relations
    metrics DeliveryMetric[]

    supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model DeliveryMetric {
    id String @id @default(uuid())

    catalogItemId String

    // Quality Performance
    qtyOrdered  Int
    qtyReceived Int
    qtyRejected Int @default(0) // Damaged, wrong item, unacceptable quality

    createdAt TimestamptzString @default(now())

    // Relations
    deliveryId String

    delivery    Delivery    @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
    catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
}
