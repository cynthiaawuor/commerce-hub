# Copy this file to `.env` for local development.

PORT=3004

# Warehouse Operations' own database (the warehouse-db service in compose.yml).
# No other service may connect to it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/service-warehouse"

# Event bus: Warehouse Operations consumes GoodsReceived to create putaway tasks
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=10000

# Phase flag for this module (phase 2). Set to "false" to hide its routes and stop
# consuming events, without removing the service.
FEATURE_WAREHOUSE=true
