# Copy this file to `.env` for local development.

PORT=3007

# Financials' own database (the financials-db service in compose.yml).
# No other service may connect to it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5441/service-financials"

# Event bus: consumes PurchaseOrderApproved, GoodsReceived, ItemSold and DayClosed.
# Financials publishes nothing.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=10000

# Inventory is asked what each product sold cost (its average cost), to book the
# cost of goods sold. While it is down, sales wait and are costed on a later pass.
INVENTORY_API_URL="http://localhost:3002/inventory-api"
INVENTORY_TIMEOUT_MS=3000
COSTING_POLL_MS=60000

# Phase flag for this module (phase 4). Set to "false" to hide its routes and stop
# handling events, without removing the service.
FEATURE_FINANCIALS=true
