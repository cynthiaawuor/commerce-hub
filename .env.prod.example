# Copy to .env.prod on the server and fill in. Never commit .env.prod.
# Passwords go inside database URLs, so use letters and digits only:
#   openssl rand -hex 24

# The domain the apps live under: vendor.$DOMAIN, pos.$DOMAIN, ...
# No domain? Use the server's IP with dashes and sslip.io: 203-0-113-5.sslip.io
DOMAIN=localhost

# The shared password in front of everything. Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs that must not be read as variables.
BASIC_AUTH_USER=demo
BASIC_AUTH_HASH='$2a$14$lEoFo0N2Wt6CjOY3hSes1erS1qGAi.FSrL3g645BT2plbn0rim.L6'

POSTGRES_PASSWORD=change-me
VENDOR_DB_PASSWORD=change-me
PROCUREMENT_DB_PASSWORD=change-me
INVENTORY_DB_PASSWORD=change-me
RECEIVING_DB_PASSWORD=change-me
WAREHOUSE_DB_PASSWORD=change-me
POS_DB_PASSWORD=change-me
SALES_AUDIT_DB_PASSWORD=change-me
FINANCIALS_DB_PASSWORD=change-me

RABBITMQ_USER=commerce
RABBITMQ_PASSWORD=change-me
