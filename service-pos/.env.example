# Copy this file to `.env` for local development.

PORT=3005

# Point of Sale's own database (the pos-db service in compose.yml).
# No other service may connect to it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5439/service-pos"

# Event bus: the till publishes ItemSold
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=2000
OUTBOX_RETRY_MAX_MS=300000

# Inventory reserves stock while the cashier takes payment
INVENTORY_API_URL="http://localhost:3002/inventory-api"
INVENTORY_TIMEOUT_MS=3000

# This store's location code in Inventory
STORE_LOCATION_CODE=STORE-3

# Shelf prices include VAT at this rate
VAT_RATE_PERCENT=16

# Phase flag for this module (phase 3). Set to "false" to hide its routes and stop
# publishing events, without removing the service.
FEATURE_POS=true
