# Copy this file to `.env` for local development.

PORT=3006

# Sales Audit's own database (the sales-audit-db service in compose.yml).
# No other service may connect to it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/service-sales-audit"

# Event bus: consumes ItemSold, publishes DayClosed
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=2000
OUTBOX_RETRY_MAX_MS=300000
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=10000

# Point of Sale is asked for its figures before a day is closed
POS_API_URL="http://localhost:3005/pos-api"
POS_TIMEOUT_MS=3000

# Phase flag for this module (phase 3). Set to "false" to hide its routes and stop
# handling events, without removing the service.
FEATURE_SALES_AUDIT=true
