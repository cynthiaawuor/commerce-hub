# Copy this file to `.env` for local development.

PORT=3002

# Inventory's own database (the inventory-db service in compose.yml).
# No other service may connect to it. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/service-inventory"

# Event bus: Inventory consumes PurchaseOrderApproved and GoodsReceived,
# and publishes StockLow.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=2000
OUTBOX_RETRY_MAX_MS=300000
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=10000

# How long a POS reservation is held before the sweeper releases it
RESERVATION_TTL_MS=900000
RESERVATION_SWEEP_MS=60000

# Quantity on order is counted against this location until the goods arrive
DEFAULT_LOCATION_CODE=WH-MAIN

# Phase flag for this module (phase 1). Set to "false" to hide its routes and stop
# consuming events, without removing the service.
FEATURE_INVENTORY=true
