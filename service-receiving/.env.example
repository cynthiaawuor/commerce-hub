# Copy this file to `.env` for local development.

PORT=3003

# Receiving's own database (the receiving-db service in compose.yml).
# No other service may connect to it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5437/service-receiving"

# Event bus: Receiving consumes PurchaseOrderApproved and publishes GoodsReceived
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
OUTBOX_POLL_MS=2000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=2000
OUTBOX_RETRY_MAX_MS=300000
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_MS=10000

# Where deliveries are taken in unless the clerk says otherwise
DEFAULT_LOCATION_CODE=WH-MAIN

# Phase flag for this module (phase 2). Set to "false" to hide its routes and stop
# consuming events, without removing the service.
FEATURE_RECEIVING=true
