# Copy to `.env` for local development.

# Base URL for service-vendor. In dev, /vendor-api is proxied to http://localhost:3000 (see vite.config.ts).
VITE_VENDOR_API_URL=/vendor-api

# Feature flag for Phase 1 module "vendor-management". When not "true", the portal shows "Coming soon".
VITE_FEATURE_VENDOR_MANAGEMENT=true
